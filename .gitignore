# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/

# Test binary, built with `go test -c`
*.test

# Test files
junit.xml

# Output of the go coverage tool
*.out
coverage.out
coverage.html

# Dependency directories
vendor/
node_modules/

# Go workspace file
go.work

# Configuration files with credentials
config.yaml
*.yaml
# Both patterns are needed: `*.env` catches names like `local.env`, while
# `.env*` catches the dotfile variants (.env.production, .env.local).
.env
*.env
.env*

# Keep example and compose files
!config.yaml.example
!docker-compose.yml
# Holds variable names and no values; `.env*` would otherwise ignore it.
!.env.example

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
*~

# OS specific files
.DS_Store
Thumbs.db

# Build artifacts
*.log

# Certificates and keys
*.pem
*.crt
*.key

# Local security scan output
reports/security/
.trivy-cache/

# Local Claude Code state (may contain internal notes)
.claude/
