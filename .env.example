# Keycloak Monitoring Tool — local development environment.
#
#     cp .env.example .env
#
# deployments/local/docker-compose.yml loads this file, so values must live
# here rather than being exported in your shell: an exported variable does not
# reach a container that is configured with env_file.
#
# These values are for local development only. Do not reuse them anywhere real.

# --- Dashboard admin, seeded on first start ------------------------------
# All three are mandatory. Without them the API aborts during startup with
# "SECURITY ERROR: default_user must be set" and never binds a port.
#
# The password is rejected if it contains any of: admin, password, secret,
# default, changeme, welcome. Substrings count, so "MyPassword1" is refused.
MONITORING_AUTH_SIMPLE_DEFAULT_USER=kmtadmin
MONITORING_AUTH_SIMPLE_DEFAULT_EMAIL=kmtadmin@example.invalid
MONITORING_AUTH_SIMPLE_DEFAULT_PASS=Ch4ng3-Me-L0cally!

# --- Session and encryption ----------------------------------------------
# Generate real values before using this anywhere but your own machine:
#     openssl rand -base64 32
MONITORING_AUTH_SESSION_SECRET=replace-with-openssl-rand-base64-32
MONITORING_SECURITY_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# --- Database -------------------------------------------------------------
# Matches the bundled postgres service in deployments/local/docker-compose.yml.
MONITORING_DATABASE_PASSWORD=monitoring_password

# --- Keycloak tenant credentials -----------------------------------------
# Only needed once you point a tenant at a real Keycloak. The suffix is the
# tenant id from config.yaml, upper-cased.
# MONITORING_KEYCLOAK_TENANTS_MY_KEYCLOAK_CLIENT_SECRET=
