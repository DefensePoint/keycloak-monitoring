# Environment for the local Docker stack (make docker-up).
#
# Copy to .env in the repository root and fill in the values:
#   cp .env.example .env
#
# deployments/local/docker-compose.yml loads this file into the api-server,
# mcp-server and web containers; Compose refuses to start without it. Shell
# exports do not reach the containers, so set values here. .env is
# gitignored; never commit real values.
#
# Compose substitutes $ in values here: single-quote any value containing $,
# or an unquoted kc-$ecret reaches the container as kc-.

# Initial admin account, created on first start against an empty database.
# All three are required; the server refuses to start without them. The
# password needs at least 12 characters with upper and lower case, a digit
# and a special character, and must not contain a common weak password such
# as admin, password, secret or 123456. Change it after the first login.
MONITORING_AUTH_SIMPLE_DEFAULT_USER=operator
MONITORING_AUTH_SIMPLE_DEFAULT_EMAIL=operator@example.com
MONITORING_AUTH_SIMPLE_DEFAULT_PASS=

# Signs the login session cookie. Required: the server refuses to start
# without it. Anyone who knows it can forge a session, so generate it and
# keep it private and stable (changing it logs everyone out):
#   openssl rand -base64 32
MONITORING_AUTH_SESSION_SECRET=

# The local stack is served over plain HTTP, where a browser drops a cookie
# marked HTTPS-only, so sign-in needs this. Deployments served over HTTPS
# leave it unset: the default is true.
MONITORING_AUTH_SESSION_SECURE=false

# Tenant secrets: write client_secret: "${PROD_KMT_CLIENT_SECRET}" in
# config.yaml and set the variable here. MONITORING_KEYCLOAK_TENANTS_*
# overrides do not work for tenant IDs with a hyphen, such as prod-keycloak.
# PROD_KMT_CLIENT_SECRET=

# Optional: base64 32-byte key that encrypts tenant client secrets at rest.
# Without it they are stored in plaintext and the server logs a warning.
# Generate with: openssl rand -base64 32
# MONITORING_SECURITY_ENCRYPTION_KEY=

# Optional bundled demo (make docker-demo-up). Fill every value below for
# that demo; generate independent values with: openssl rand -hex 24
# Keep these values between restarts. Changing the database or bootstrap
# admin password requires an explicit password change or a demo reset.
# Client secrets are reconciled automatically by the setup container.
BUNDLED_DB_PASSWORD=
BUNDLED_KC_ADMIN_PASSWORD=
BUNDLED_KC1_CLIENT_SECRET=
BUNDLED_KC2_CLIENT_SECRET=
BUNDLED_SESSION_SECRET=
