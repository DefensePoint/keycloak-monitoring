# Frontend build-time configuration.
#
# Copy to .env.local for local development. Vite inlines these at BUILD time,
# so they cannot be changed at runtime: a deployed bundle carries whatever was
# set when it was built. .env.local is gitignored; never commit real values.

# Free CARTO basemaps API key for the AMFA geolocation map.
#
# Optional. Without it the map still renders, but CARTO serves every tile with
# "API KEY REQUIRED" watermarked across it, which looks like a broken map even
# though every network request returns 200.
#
# Request one at https://carto.com/basemaps/apikey/ — it asks for an email, the
# domain you serve from, and what you are building, and is emailed straight
# back with no approval queue and no CARTO account. Free up to 5 million tile
# requests per calendar month, commercial use included.
#
# Get your own rather than reusing someone else's: CARTO's terms ask that a key
# is not shared or reused across unrelated projects, and the quota is per key.
VITE_CARTO_BASEMAP_KEY=

# Base URL for API requests. Empty means same-origin, which is what the
# bundled web server expects.
VITE_API_URL=
